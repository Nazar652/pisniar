# Copy to `.env` and fill in real values yourself.
# NEVER commit `.env` — it is git-ignored on purpose.
#
# DATABASE_URL / REDIS_URL are not here on purpose: they are the in-network
# DNS names of the `postgres` / `redis` compose services, fixed by
# compose.yaml. Only fill in what only you know.

ENVIRONMENT=docker
# Independent of ENVIRONMENT on purpose — "json" (this default) for the
# prod/docker path `compose.yaml` alone runs; `compose.override.yml`
# overrides this to "console" for `make up`, regardless of what's here.
LOG_FORMAT=json
LOG_LEVEL=INFO

# Telegram bot token from @BotFather.
BOT_TOKEN=000000000:REPLACE_WITH_REAL_BOT_TOKEN

# Comma-separated Telegram user_id of the two admins allowed to use the bot.
ADMIN_IDS=111111111,222222222

# Telegram chat_id that receives operational alerts (usually one of the admins,
# or a private group with the admins in it).
ALERT_CHAT_ID=111111111

# Numeric chat_id of the channel posts are published to, never an @username
# (a username can be pointed at another chat, an id cannot). Get it e.g. by
# forwarding a channel post to @userinfobot. Keep it different from
# ALERT_CHAT_ID on the real channel: alerts carry error texts, post ids and
# other tracks' source URLs, and would otherwise go out to subscribers. The
# bot must be an administrator there with "post messages" enabled.
CHANNEL_ID=-1001234567890

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Spotify Web API (Client Credentials flow) — https://developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=REPLACE_WITH_REAL_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=REPLACE_WITH_REAL_SPOTIFY_CLIENT_SECRET

# Optional: enables the `musicbrainz` source once set (contact required by
# their usage policy, e.g. an email or project URL). Leave unset to disable it.
# MUSICBRAINZ_CONTACT=you@example.com

# iTunes Search API storefront — without it the default US storefront is used.
ITUNES_COUNTRY=UA

# How long a cached source answer stays fresh, positive and negative alike.
# Past it, `/retry` re-asks every source instead of replaying a miss.
SOURCE_FETCH_TTL_SECONDS=3600

# Where step 4's audio and rendered video live inside the worker container.
# `compose.yaml` mounts the named `media-data` volume there — change this and
# the volume stops being the place the files go. Must be an absolute path.
MEDIA_ROOT=/data

# Free space a download refuses to start below (bytes). Running out mid-render
# is the failure mode that leaves a file looking finished; the check is made
# before the download, not after. A measured render is ~2.3 MB, audio ~5 MB.
MEDIA_MIN_FREE_BYTES=2000000000

# Step 4's own task limits, deliberately separate from the resolve ones: those
# are hardcoded in `worker/celery_app.py` and also decide when `/retry` calls a
# stuck resolve stale, so raising them for a render would silently widen that
# window. Soft must stay below hard — the soft one is what lets a task clean up
# its `.partial` files before the hard one kills it.
DOWNLOAD_TASK_SOFT_TIME_LIMIT_SECONDS=120
DOWNLOAD_TASK_TIME_LIMIT_SECONDS=180
# The render also asks LRCLIB for lyrics, whose worst case (timeouts, retries,
# the fallback search) is ~187 s: a slow LRCLIB must still end as a video
# without text. The hard limit is also how long `/retry` waits before it calls
# a stuck render stale.
RENDER_TASK_SOFT_TIME_LIMIT_SECONDS=360
RENDER_TASK_TIME_LIMIT_SECONDS=420

# Redis `requirepass`. Required — compose refuses to start without it, and
# there is no default: `compose.override.yml` publishes the broker on
# 127.0.0.1:56379, and anything that can write to the broker can make the
# worker act without passing AdminAllowlistMiddleware. Generate your own, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(24))"`, and keep it
# URL-safe — compose builds REDIS_URL as `redis://:<password>@redis:6379/0`.
# Changing it needs `docker compose up -d --force-recreate`, not `restart`.
REDIS_PASSWORD=REPLACE_WITH_A_GENERATED_REDIS_PASSWORD
