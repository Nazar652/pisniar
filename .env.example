# copy to `.env` and fill in real values; never commit `.env` (it is git-ignored).
# DATABASE_URL/REDIS_URL are absent on purpose: compose.yaml fixes them to its service DNS names.

ENVIRONMENT=docker
# independent of ENVIRONMENT: "json" for `compose.yaml` alone, while
# `compose.override.yml` forces "console" for `make up` regardless of this value.
LOG_FORMAT=json
LOG_LEVEL=INFO

# telegram bot token from @BotFather.
BOT_TOKEN=000000000:REPLACE_WITH_REAL_BOT_TOKEN

# comma-separated Telegram user_id of the two admins allowed to use the bot.
ADMIN_IDS=111111111,222222222

# telegram chat_id that receives operational alerts (usually one of the admins,
# or a private group with the admins in it).
ALERT_CHAT_ID=111111111

# numeric channel id, never an @username (it can be repointed); forward a post to @userinfobot.
# The bot needs admin "post messages" there; keep it apart from ALERT_CHAT_ID, alerts are not public.
CHANNEL_ID=-1001234567890

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# spotify Web API (Client Credentials flow) — https://developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=REPLACE_WITH_REAL_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=REPLACE_WITH_REAL_SPOTIFY_CLIENT_SECRET

# optional `musicbrainz` source, off while unset; their policy requires a contact (email or URL).
# MUSICBRAINZ_CONTACT=you@example.com

# iTunes Search API storefront — without it the default US storefront is used.
ITUNES_COUNTRY=UA

# how long a cached source answer stays fresh, positive and negative alike.
# Past it, `/retry` re-asks every source instead of replaying a miss.
SOURCE_FETCH_TTL_SECONDS=3600

# absolute path of audio and rendered video in the worker; `compose.yaml` mounts the
# `media-data` volume there, so changing it moves the files off the volume.
MEDIA_ROOT=/data

# free bytes below which a download refuses to start: running out mid-render leaves a file
# that looks finished. A 120 s render is ~22 MB, audio ~5 MB.
MEDIA_MIN_FREE_BYTES=2000000000

# separate from the resolve limits in `worker/celery_app.py`, which also set when `/retry` calls
# a resolve stale. Soft stays below hard so a task can clean up its `.partial` files first.
DOWNLOAD_TASK_SOFT_TIME_LIMIT_SECONDS=120
DOWNLOAD_TASK_TIME_LIMIT_SECONDS=180
# the render waits on LRCLIB (worst case ~187 s) and must still end as a video without text.
# The hard limit is also how long `/retry` waits before it calls a stuck render stale;
# `make bench-render` prints the values for the host it runs on.
RENDER_TASK_SOFT_TIME_LIMIT_SECONDS=600
RENDER_TASK_TIME_LIMIT_SECONDS=660
# the plain-text lyrics task (Genius) that the render queues after the preview; it is never retried.
PLAIN_LYRICS_TASK_SOFT_TIME_LIMIT_SECONDS=60
PLAIN_LYRICS_TASK_TIME_LIMIT_SECONDS=90

# required: the broker is published on 127.0.0.1:56379 and a write there bypasses the admin allowlist.
# URL-safe, e.g. `python -c "import secrets; print(secrets.token_urlsafe(24))"`; apply with `up -d --force-recreate`.
REDIS_PASSWORD=REPLACE_WITH_A_GENERATED_REDIS_PASSWORD

# public origin of the Mini App (the Tailscale Funnel URL), https only and without a path.
# Unset keeps the Mini App buttons off; apply with `up -d --force-recreate bot worker webapp`.
# WEBAPP_PUBLIC_URL=https://pisniar.your-tailnet.ts.net

# Mini App sign-in windows, in seconds: how old or how far ahead `initData` may be, and how long a session lasts.
# WEBAPP_AUTH_MAX_AGE_SECONDS=600
# WEBAPP_AUTH_MAX_FUTURE_SECONDS=60
# WEBAPP_SESSION_TTL_SECONDS=3600
# how long the signed audio URL of the fragment editor stays valid, in seconds.
# WEBAPP_MEDIA_URL_TTL_SECONDS=900
